{
  "schemaVersion": 2,
  "name": "KazumiRules 转写订阅",
  "description": "由 Predidit/KazumiRules 的 Kazumi 规则逐条转写为 Animeko web-selector 数据源",
  "websiteUrl": "https://github.com/Predidit/KazumiRules",
  "mediaSources": [
    {
      "id": "kazumi-7sefun",
      "factoryId": "web-selector",
      "version": 2,
      "arguments": {
        "name": "7sefun",
        "description": "由 KazumiRules 的 7sefun v1.3 规则转写",
        "iconUrl": "https://www.7sefun.top/favicon.ico",
        "searchConfig": {
          "searchUrl": "https://www.7sefun.top/vodsearch/-------------.html?wd={keyword}",
          "subjectFormatId": "indexed",
          "channelFormatId": "index-grouped",
          "selectorSubjectFormatIndexed": {
            "selectNames": "div.videos > div.video.anim:nth-child(-n+6) > div.video-by",
            "selectLinks": "div.videos > div.video.anim:nth-child(-n+6) a.video-wrapper"
          },
          "selectorChannelFormatFlattened": {
            "selectChannelNames": "div.chat:has(.vod-play-list-container) > div.chat-header.anim",
            "matchChannelName": "(?<ch>[^\\s]+线)$",
            "selectEpisodeLists": "div.message-container.vod-play-list-container",
            "selectEpisodesFromList": "a"
          }
        },
        "tier": 2
      }
    },
    {
      "id": "kazumi-age",
      "factoryId": "web-selector",
      "version": 2,
      "arguments": {
        "name": "AGE",
        "description": "由 KazumiRules 的 AGE v1.6 规则转写",
        "iconUrl": "https://www.agedm.io/favicon.ico",
        "searchConfig": {
          "searchUrl": "https://www.agedm.io/search?query={keyword}",
          "subjectFormatId": "indexed",
          "channelFormatId": "index-grouped",
          "selectorSubjectFormatIndexed": {
            "selectNames": "div.card.cata_video_item h5.card-title",
            "selectLinks": "div.card.cata_video_item a.d-block"
          },
          "selectorChannelFormatFlattened": {
            "selectChannelNames": "ul.nav.nav-pills > li.nav-item > button.nav-link",
            "matchChannelName": "^(?<ch>.+?)(?:\\s+\\d+)?$",
            "selectEpisodeLists": "div.tab-content > div.tab-pane",
            "selectEpisodesFromList": "ul.video_detail_episode a"
          }
        },
        "tier": 2
      }
    },
    {
